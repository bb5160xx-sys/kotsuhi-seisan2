  // 区間1・区間2、それぞれの「プリセット選択欄＋今回だけ使う／保存する」一式を
  // まとめて設定するための共通処理（同じ仕組みを2回使い回しています）
  function setupTrainSlot(opts){
    function applyFromPreset(){
      var p = trainPresets.find(function(x){ return x.id === opts.selectEl.value; });
      if(p){
        opts.slotState.fare = Number(p.fare) || 0;
        opts.slotState.route = p.from + " → " + p.to;
      }else{
        opts.slotState.fare = 0;
        opts.slotState.route = null;
      }
      updateTrainSlotSummary(opts.num, opts.slotState);
      recalcTrainAmount();
    }
    opts.selectEl.addEventListener("change", applyFromPreset);

    opts.useOnceBtn.addEventListener("click", function(){
      var from = opts.fromEl.value.trim();
      var to = opts.toEl.value.trim();
      var fare = Number(opts.fareEl.value);
      if(!fare || fare<=0){
        showToast("運賃を入力してください。");
        return;
      }
      opts.selectEl.value = ""; // プリセットの選択は解除
      opts.slotState.fare = fare;
      opts.slotState.route = (from && to) ? (from + " → " + to) : null;
      updateTrainSlotSummary(opts.num, opts.slotState);
      recalcTrainAmount();
      showToast("区間" + opts.num + "：今回の運賃として入力しました（保存はしていません）。");
    });

    opts.addBtn.addEventListener("click", function(){
      var from = opts.fromEl.value.trim();
      var to = opts.toEl.value.trim();
      var fare = Number(opts.fareEl.value);
      if(!from || !to || !fare || fare<=0){
        showToast("出発駅・到着駅・運賃をすべて入力してください。");
        return;
      }
      var p = upsertTrainPreset(from, to, fare);
      populateTrainPresetSelect();
      opts.selectEl.value = p.id;
      opts.slotState.fare = p.fare;
      opts.slotState.route = from + " → " + to;
      updateTrainSlotSummary(opts.num, opts.slotState);
      recalcTrainAmount();
      showToast("区間を保存しました：" + from + " → " + to);
      opts.fromEl.value = "";
      opts.toEl.value = "";
      opts.fareEl.value = "";
    });

    return {
      reset: function(){
        opts.selectEl.value = "";
        opts.fromEl.value = "";
        opts.toEl.value = "";
        opts.fareEl.value = "";
        opts.slotState.fare = 0;
        opts.slotState.route = null;
        updateTrainSlotSummary(opts.num, opts.slotState);
      }
    };
  }

