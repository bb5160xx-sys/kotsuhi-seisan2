<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>交通費精算</title>
<style>
  /* GitHub Pages等で単体表示するための最低限のリセット
     （Claude Artifactでは自動的に付与されていたものを明示的に追加） */
  html, body{ height:100%; margin:0; }
  img{ max-width:100%; }
  [hidden]{ display:none !important; }

  /* ===== 配色・文字などの基本設定（トークン） ===== */
  :root{
    --bg-outer:#e7ebf1;
    --bg:#f5f6f8;
    --surface:#ffffff;
    --surface-2:#eef1f5;
    --border:#dfe3e9;
    --text:#1a2233;
    --text-muted:#606a7d;
    --primary:#20456b;
    --primary-dark:#173250;
    --primary-soft:#e4ecf4;
    --primary-contrast:#ffffff;
    --danger:#b3261e;
    --danger-soft:#fbe4e2;
    --pending-fg:#8a5a00;
    --pending-bg:#fff2d6;
    --approved-fg:#1e7a43;
    --approved-bg:#e0f5e6;
    --rejected-fg:#b3261e;
    --rejected-bg:#fce3e1;
    --received-fg:#0f5fa8;
    --received-bg:#dbe9fb;
    --radius:14px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg-outer:#0b0e14;
      --bg:#12161f;
      --surface:#1b212c;
      --surface-2:#232a37;
      --border:#2e3646;
      --text:#eef1f6;
      --text-muted:#9aa4b6;
      --primary:#6fa3d6;
      --primary-dark:#4a7dab;
      --primary-soft:#233248;
      --primary-contrast:#0d1420;
      --danger:#ff8a80;
      --danger-soft:#3a2224;
      --pending-fg:#f3c66b;
      --pending-bg:#3a2f13;
      --approved-fg:#7bd39a;
      --approved-bg:#173625;
      --rejected-fg:#ff8a80;
      --rejected-bg:#3a2224;
      --received-fg:#8ec4f5;
      --received-bg:#152a40;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"]{
    --bg-outer:#0b0e14;
    --bg:#12161f;
    --surface:#1b212c;
    --surface-2:#232a37;
    --border:#2e3646;
    --text:#eef1f6;
    --text-muted:#9aa4b6;
    --primary:#6fa3d6;
    --primary-dark:#4a7dab;
    --primary-soft:#233248;
    --primary-contrast:#0d1420;
    --danger:#ff8a80;
    --danger-soft:#3a2224;
    --pending-fg:#f3c66b;
    --pending-bg:#3a2f13;
    --approved-fg:#7bd39a;
    --approved-bg:#173625;
    --rejected-fg:#ff8a80;
    --rejected-bg:#3a2224;
    --received-fg:#8ec4f5;
    --received-bg:#152a40;
    color-scheme: dark;
  }

  *{ box-sizing:border-box; }
  body{
    margin:0;
    background:var(--bg-outer);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Hiragino Kaku Gothic ProN","Yu Gothic",system-ui,sans-serif;
    display:flex;
    justify-content:center;
    min-height:100%;
  }
  #app{
    width:100%;
    max-width:480px;
    min-height:100dvh;
    background:var(--bg);
    display:flex;
    flex-direction:column;
    position:relative;
  }
  @media (min-width:560px){
    body{ padding-block:32px; }
    #app{
      min-height:min(860px,calc(100dvh - 64px));
      border-radius:28px;
      box-shadow:0 20px 60px rgba(20,30,50,.25);
      overflow:hidden;
      border:1px solid var(--border);
    }
  }

  .view{ display:flex; flex-direction:column; flex:1; min-height:0; }
  .view[hidden]{ display:none !important; }

  .topbar{
    position:sticky;
    top:env(safe-area-inset-top,0px);
    z-index:5;
    background:var(--primary);
    color:var(--primary-contrast);
    padding:14px 16px;
    padding-top:calc(14px);
    display:flex;
    align-items:center;
    gap:8px;
  }
  .topbar h1{ font-size:17px; margin:0; font-weight:700; letter-spacing:.02em; }
  .btn-icon{
    appearance:none; border:none; background:transparent; color:inherit;
    font-size:26px; line-height:1; width:32px; height:32px;
    display:flex; align-items:center; justify-content:center;
    border-radius:8px; cursor:pointer;
  }
  .btn-icon:active{ background:rgba(255,255,255,.15); }

  .content{
    padding:16px 16px calc(28px + env(safe-area-inset-bottom,0px));
    display:flex;
    flex-direction:column;
    gap:16px;
    overflow-y:auto;
  }

  .btn-primary{
    appearance:none; border:none; cursor:pointer;
    background:var(--primary); color:var(--primary-contrast);
    font-size:15px; font-weight:700;
    padding:14px 18px; border-radius:12px;
    transition:transform .05s ease;
  }
  .btn-primary:active{ transform:scale(.98); background:var(--primary-dark); }
  .btn-block{ width:100%; }

  .btn-secondary{
    appearance:none; cursor:pointer;
    background:var(--surface); color:var(--text);
    border:1px solid var(--border);
    font-size:14px; font-weight:600;
    padding:12px 16px; border-radius:12px;
  }
  .btn-secondary:active{ background:var(--surface-2); }

  .btn-danger-text{
    appearance:none; background:none; border:none; cursor:pointer;
    color:var(--danger); font-size:14px; font-weight:600; padding:8px 0;
  }
  .btn-danger{
    appearance:none; border:none; cursor:pointer;
    background:var(--danger); color:#fff;
    font-size:15px; font-weight:700; padding:14px 18px; border-radius:12px;
  }
  .btn-danger:active{ opacity:.85; }

  /* ---- ホーム：集計チップ ---- */
  .stats{ display:flex; gap:8px; }
  .stat-chip{
    flex:1; background:var(--surface); border:1px solid var(--border);
    border-radius:12px; padding:10px 8px; text-align:center;
  }
  .stat-chip .num{ font-size:20px; font-weight:700; font-variant-numeric:tabular-nums; display:block; }
  .stat-chip .label{ font-size:11px; color:var(--text-muted); }

  .section-title{ font-size:14px; font-weight:700; color:var(--text-muted); margin:4px 0 0; }

  .empty-state{
    background:var(--surface); border:1px dashed var(--border); border-radius:var(--radius);
    padding:28px 16px; text-align:center; color:var(--text-muted); font-size:13px;
  }

  .history-list{ display:flex; flex-direction:column; gap:10px; }
  .claim-card{
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    padding:12px; display:flex; align-items:center; gap:12px;
    cursor:pointer; text-align:left; width:100%; appearance:none;
  }
  .claim-card:active{ background:var(--surface-2); }
  .cat-badge{
    flex:none; width:40px; height:40px; border-radius:50%;
    background:var(--primary-soft); color:var(--primary);
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:15px;
  }
  .claim-main{ flex:1; min-width:0; }
  .claim-purpose{ font-size:14px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .claim-sub{ font-size:12px; color:var(--text-muted); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .claim-amount{ font-size:15px; font-weight:700; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .claim-right{ display:flex; flex-direction:column; align-items:flex-end; gap:6px; }

  .status-pill{
    font-size:11px; font-weight:700; padding:3px 9px; border-radius:999px; white-space:nowrap;
  }
  .status-pill[data-status="申請中"]{ background:var(--pending-bg); color:var(--pending-fg); }
  .status-pill[data-status="承認済み"]{ background:var(--approved-bg); color:var(--approved-fg); }
  .status-pill[data-status="差戻し"]{ background:var(--rejected-bg); color:var(--rejected-fg); }
  .status-pill[data-status="受領済み"]{ background:var(--received-bg); color:var(--received-fg); }

  /* ---- フォーム ---- */
  label, .field-block{ display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600; color:var(--text-muted); }
  input[type="date"], input[type="text"], input[type="number"], textarea{
    font:inherit; font-size:16px; color:var(--text);
    background:var(--surface); border:1px solid var(--border); border-radius:10px;
    padding:11px 12px; width:100%;
  }
  input:focus, textarea:focus, button:focus-visible{
    outline:2px solid var(--primary); outline-offset:1px;
  }
  textarea{ resize:vertical; font-family:inherit; }

  /* 数字入力欄の右側にある増減ボタン（スピナー）を非表示にする */
  input[type="number"]::-webkit-outer-spin-button,
  input[type="number"]::-webkit-inner-spin-button{
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"]{
    -moz-appearance: textfield;
  }

  .chip-group{ display:flex; flex-wrap:wrap; gap:8px; }
  .chip{
    appearance:none; cursor:pointer; font:inherit; font-size:13px; font-weight:600;
    background:var(--surface); color:var(--text); border:1px solid var(--border);
    border-radius:999px; padding:9px 14px;
  }
  .chip[aria-pressed="true"]{ background:var(--primary); color:var(--primary-contrast); border-color:var(--primary); }

  .amount-field{ display:flex; align-items:center; background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:0 12px; }
  .amount-field span{ color:var(--text-muted); font-weight:700; }
  .amount-field input{ border:none; padding:11px 6px; background:transparent; }
  .amount-field input:focus{ outline:none; }

  .file-row{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .file-label{
    display:inline-flex; align-items:center; justify-content:center;
    background:var(--surface-2); border:1px solid var(--border); border-radius:10px;
    padding:11px 14px; font-size:13px; font-weight:600; cursor:pointer; color:var(--text);
  }
  #receiptPreview{ max-width:96px; max-height:96px; border-radius:8px; border:1px solid var(--border); object-fit:cover; }
  .field-error{ color:var(--danger); font-size:12px; font-weight:600; display:none; }
  .field-error.show{ display:block; }

  /* ---- 詳細画面 ---- */
  .detail-block{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:16px; display:flex; flex-direction:column; gap:12px; }
  .detail-row{ display:flex; justify-content:space-between; gap:12px; font-size:14px; }
  .detail-row .k{ color:var(--text-muted); }
  .detail-row .v{ font-weight:600; text-align:right; }
  .detail-memo{ font-size:13px; line-height:1.6; white-space:pre-wrap; }
  .detail-receipt{ width:100%; border-radius:10px; border:1px solid var(--border); }
  .status-switch{ display:flex; gap:8px; }
  .status-switch button{ flex:1; padding:10px 8px; font-size:12px; }
  .status-switch button[aria-pressed="true"]{ box-shadow:inset 0 0 0 2px var(--primary); }
  .hint{ font-size:11px; color:var(--text-muted); line-height:1.5; }

  /* ---- 区間・距離の入力補助（電車代／自家用車） ---- */
  select{
    font:inherit; font-size:16px; color:var(--text);
    background:var(--surface); border:1px solid var(--border); border-radius:10px;
    padding:11px 12px; width:100%;
  }
  .route-block{
    background:var(--surface-2); border:1px solid var(--border); border-radius:12px;
    padding:12px; display:flex; flex-direction:column; gap:10px;
  }
  .mini-label{ font-size:12px; font-weight:700; color:var(--text-muted); }
  .link-btn{
    appearance:none; background:none; border:none; cursor:pointer;
    color:var(--primary); font-size:13px; font-weight:700; text-decoration:underline;
    padding:2px 0; text-align:left; align-self:flex-start;
  }
  .computed-amount{ font-size:13px; color:var(--text-muted); }
  .computed-amount strong{ color:var(--text); font-size:16px; font-variant-numeric:tabular-nums; }
  .mini-form{
    display:flex; flex-direction:column; gap:8px;
    background:var(--surface); border:1px dashed var(--border); border-radius:10px; padding:10px;
  }
  .mini-form-row{ display:flex; gap:8px; }
  .mini-form-row > *{ flex:1; min-width:0; }

  /* ---- 区間・距離の管理画面 ---- */
  .preset-row{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:10px 12px;
  }
  .preset-row .info b{ font-size:13px; }
  .preset-row .info .sub{ font-size:11px; color:var(--text-muted); margin-top:2px; }
  .preset-del{
    appearance:none; border:none; background:none; cursor:pointer;
    color:var(--danger); font-size:12px; font-weight:700; padding:4px 6px; white-space:nowrap;
  }

  /* ---- 通知（トースト）・確認ダイアログ ----
     このページはArtifactのサンドボックス内で動くため、ブラウザ標準の
     alert()やconfirm()が表示されないことがあります。
     その代わりにページ内で完結する通知・確認UIを自前で用意しています。 */
  .toast{
    position:fixed; left:50%; bottom:calc(20px + env(safe-area-inset-bottom,0px));
    transform:translateX(-50%) translateY(12px);
    background:var(--text); color:var(--bg);
    padding:10px 18px; border-radius:999px; font-size:13px; font-weight:600;
    max-width:88%; text-align:center; box-shadow:0 8px 24px rgba(0,0,0,.28);
    opacity:0; pointer-events:none; transition:opacity .2s ease, transform .2s ease;
    z-index:80;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

  .confirm-overlay{
    position:fixed; inset:0; background:rgba(10,14,20,.5);
    display:flex; align-items:center; justify-content:center; z-index:90; padding:20px;
  }
  .confirm-overlay[hidden]{ display:none; }
  .confirm-card{
    background:var(--surface); border-radius:16px; padding:20px; max-width:320px; width:100%;
    display:flex; flex-direction:column; gap:16px; box-shadow:0 20px 50px rgba(0,0,0,.3);
  }
  .confirm-card p{ margin:0; font-size:14px; line-height:1.7; color:var(--text); white-space:pre-line; }
  .confirm-actions{ display:flex; gap:8px; }
  .confirm-actions button{ flex:1; }
  .notify-textarea{
    width:100%; font:inherit; font-size:12px; line-height:1.6; padding:10px;
    border:1px solid var(--border); border-radius:10px; background:var(--surface-2); color:var(--text);
    resize:vertical;
  }
</style>
</head>
<body>
<div id="app">

  <!-- ============ 画面1: トップ ============ -->
  <section class="view" data-view="home">
    <header class="topbar"><h1>交通費精算</h1></header>
    <div class="content">
      <button id="newClaimBtn" class="btn-primary btn-block">＋ 新しく申請する</button>
      <button id="openPresetsBtn" class="btn-secondary btn-block">⚙ 申請者・区間の管理</button>

      <div class="stats" id="statsRow"></div>

      <h2 class="section-title">申請履歴</h2>
      <div id="historyList" class="history-list"></div>
    </div>
  </section>

  <!-- ============ 画面2: 新規申請 ============ -->
  <section class="view" data-view="form" hidden>
    <header class="topbar">
      <button class="btn-icon" id="formBackBtn" aria-label="戻る">‹</button>
      <h1>新規申請</h1>
    </header>
    <form class="content" id="claimForm" novalidate>

      <label>申請者
        <div class="chip-group" id="applicantGroup" role="group" aria-label="申請者"></div>
        <span class="field-error" id="errApplicant">申請者を選択してください</span>
      </label>
      <div class="mini-form" id="applicantAddForm">
        <div class="mini-form-row">
          <input type="text" id="qNewApplicantName" placeholder="名前を追加（例：山田 太郎）">
          <button type="button" id="qAddApplicantBtn" class="btn-secondary">＋ 追加</button>
        </div>
        <span class="hint">一度追加すればタップで選べます。前回選んだ人はこの端末で自動的に選択されます。</span>
        <button type="button" class="btn-danger-text" id="deleteSelectedApplicantBtn" style="align-self:flex-start;">選択中の申請者を一覧から削除する</button>
      </div>

      <label>利用日
        <input type="date" id="fDate" required>
      </label>

      <label>経費種別
        <div class="chip-group" id="categoryGroup" role="group" aria-label="経費種別">
          <button type="button" class="chip" data-value="高速代">高速代</button>
          <button type="button" class="chip" data-value="駐車代">駐車代</button>
          <button type="button" class="chip" data-value="電車代">電車代</button>
          <button type="button" class="chip" data-value="自家用車">自家用車</button>
          <button type="button" class="chip" data-value="その他">その他</button>
        </div>
        <span class="field-error" id="errCategory">経費種別を選択してください</span>
      </label>

      <div id="destinationBlock" style="display:flex;flex-direction:column;gap:10px;">
        <label>訪問先
          <input type="text" id="fDestination" placeholder="例：〇〇株式会社">
          <span class="field-error" id="errDestination">訪問先を入力してください</span>
        </label>
        <div class="mini-form">
          <span class="mini-label">よく使う訪問先から選ぶ（任意）</span>
          <select id="destinationPresetSelect">
            <option value="">－ 保存済みの訪問先から選択 －</option>
          </select>
          <button type="button" class="btn-danger-text" id="deleteDestinationPresetBtn" style="align-self:flex-start;">選択中の訪問先をプリセットから削除する</button>
          <button type="button" class="btn-secondary" id="saveDestinationPresetBtn">＋ この訪問先をプリセットに保存する</button>
        </div>
      </div>

      <label>利用目的
        <div class="chip-group" id="purposeGroup" role="group" aria-label="利用目的">
          <button type="button" class="chip" data-value="配達">配達</button>
          <button type="button" class="chip" data-value="打合せ">打合せ</button>
          <button type="button" class="chip" data-value="営業">営業</button>
          <button type="button" class="chip" data-value="現場">現場</button>
          <button type="button" class="chip" data-value="会議">会議</button>
          <button type="button" class="chip" data-value="懇親会">懇親会</button>
          <button type="button" class="chip" data-value="その他">その他</button>
        </div>
        <span class="field-error" id="errPurposeType">利用目的を選択してください</span>
      </label>

      <!-- 電車代：保存済みの区間から運賃を選ぶ（複数区間をまとめて申請したい場合は区間2も使えます） -->
      <div id="trainRouteBlock" class="route-block" hidden>
        <span class="mini-label">区間1</span>
        <select id="trainPresetSelect">
          <option value="">－ 保存済みの区間から選択 －</option>
        </select>
        <button type="button" class="btn-danger-text" id="deleteTrainPreset1Btn" style="align-self:flex-start;">選択中の区間をプリセットから削除する</button>
        <div class="mini-form">
          <div class="mini-form-row">
            <input type="text" id="qNewTrainFrom" placeholder="出発駅（例：座間）">
            <input type="text" id="qNewTrainTo" placeholder="到着駅（例：新宿）">
          </div>
          <div class="amount-field">
            <span>¥</span>
            <input type="number" id="qNewTrainFare" min="0" step="1" placeholder="運賃（片道）">
          </div>
          <div class="mini-form-row">
            <button type="button" class="btn-secondary" id="qUseOnceBtn">今回だけ使う（保存しない）</button>
            <button type="button" class="btn-secondary" id="qAddTrainBtn">保存して次回も選べるようにする</button>
          </div>
        </div>
        <div class="computed-amount">区間1：<strong id="trainRoute1Summary">未設定</strong></div>

        <span class="mini-label">区間2（乗り継ぎなど、複数区間をまとめて1回で申請する場合。任意）</span>
        <select id="trainPresetSelect2">
          <option value="">－ 追加しない －</option>
        </select>
        <button type="button" class="btn-danger-text" id="deleteTrainPreset2Btn" style="align-self:flex-start;">選択中の区間をプリセットから削除する</button>
        <div class="mini-form">
          <div class="mini-form-row">
            <input type="text" id="qNewTrainFrom2" placeholder="出発駅（例：新宿）">
            <input type="text" id="qNewTrainTo2" placeholder="到着駅（例：渋谷）">
          </div>
          <div class="amount-field">
            <span>¥</span>
            <input type="number" id="qNewTrainFare2" min="0" step="1" placeholder="運賃（片道）">
          </div>
          <div class="mini-form-row">
            <button type="button" class="btn-secondary" id="qUseOnceBtn2">今回だけ使う（保存しない）</button>
            <button type="button" class="btn-secondary" id="qAddTrainBtn2">保存して次回も選べるようにする</button>
          </div>
        </div>
        <div class="computed-amount">区間2：<strong id="trainRoute2Summary">未設定</strong></div>

        <span class="hint">区間1・区間2はそれぞれ独立して操作できます。両方設定すると運賃が合算され、金額欄に自動入力されます。</span>
      </div>

      <!-- 自家用車：区間ごとに出発地・到着地・距離を入力し、自動計算（30円/km）。区間1は必須、区間2〜4は必要なときだけボタンで追加します -->
      <div id="carRouteBlock" class="route-block" hidden>
