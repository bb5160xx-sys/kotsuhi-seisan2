    var block = document.getElementById("finalRouteSummaryBlock");
    var text = document.getElementById("finalRouteSummaryText");
    var note = null;
    if(selectedCategory === "電車代") note = trainRouteNoteCombined;
    else if(selectedCategory === "自家用車") note = carRouteNoteCombined;
    if(note){
      text.textContent = note;
      block.hidden = false;
    }else{
      block.hidden = true;
    }
  }

  function updateTrainSlotSummary(slotNum, slotState){
    var el = document.getElementById("trainRoute" + slotNum + "Summary");
