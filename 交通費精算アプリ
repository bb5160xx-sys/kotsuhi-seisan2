  /* ---- 電車代：区間1・区間2の運賃を合算 ----
     区間1・区間2はそれぞれ独立した「プリセットから選ぶ／今回だけ入力する／
     保存する」の3点セットを持っていて、お互いに干渉しません。 */
  var trainSlot1 = { fare: 0, route: null };
  var trainSlot2 = { fare: 0, route: null };
  var trainRouteNoteCombined = null;

  function recalcTrainAmount(){
    var total = trainSlot1.fare + trainSlot2.fare;
    if(total > 0){ fAmount.value = total; }
    var notes = [];
    if(trainSlot1.route) notes.push(trainSlot1.route);
    if(trainSlot2.route) notes.push(trainSlot2.route);
    trainRouteNoteCombined = notes.length ? notes.join("／") : null;
    updateFinalRouteSummary();
  }

