    var mapsBtn = document.getElementById("carMapsBtn" + n);
    var saveBtn = document.getElementById("saveCarPreset" + n + "Btn");
    var deleteBtn = document.getElementById("deleteCarPreset" + n + "Btn");
    var summaryEl = document.getElementById("carLeg" + n + "Summary");

    function getOriginText(){
      return originInput.value.trim();
    }
    function updateSummary(){
      var o = getOriginText();
      var d = destinationInput.value.trim();
      var km = Number(distanceInput.value) || 0;
      if(o && d && km > 0){
        summaryEl.textContent = o + " → " + d + "（" + km + "km・" + formatYen(calcCarYen(km)) + "）";
      }else if(o || d || km){
        summaryEl.textContent = "（出発地・到着地・距離をすべて入力してください）";
      }else{
        summaryEl.textContent = "未設定";
      }
    }

    originInput.addEventListener("input", function(){ updateSummary(); recalcCarAmount(); });
    destinationInput.addEventListener("input", function(){ updateSummary(); recalcCarAmount(); });
    distanceInput.addEventListener("input", function(){ updateSummary(); recalcCarAmount(); });

    selectEl.addEventListener("change", function(){
      var p = carPresets.find(function(x){ return x.id === selectEl.value; });
      if(!p) return;
      originInput.value = p.origin;
      destinationInput.value = p.destination;
      distanceInput.value = p.distanceKm;
      updateSummary();
      recalcCarAmount();
    });

    /* 「マップで調べる」はボタンではなく本物のリンク（<a target="_blank">）にしています。
       JavaScriptのwindow.open()は環境によってポップアップとして
       ブロックされることがありますが、タップした瞬間にリンク先(href)を
       組み立ててから遷移させる方式なら、ブラウザに通常のリンクとして
       扱われるため、iPhoneのSafariでも確実に新しいタブでGoogleマップが開きます。 */
    mapsBtn.addEventListener("click", function(ev){
      var origin = getOriginText();
      var destination = destinationInput.value.trim();
      if(!origin || !destination){
        ev.preventDefault();
        showToast("出発地と到着地を入力してからお試しください。");
        return;
      }
      this.href = "https://www.google.com/maps/dir/?api=1&origin=" + encodeURIComponent(origin) +
        "&destination=" + encodeURIComponent(destination) + "&travelmode=driving";
    });

    saveBtn.addEventListener("click", function(){
      var origin = getOriginText();
      var destination = destinationInput.value.trim();
      var km = Number(distanceInput.value);
      if(!origin || !destination || !(km > 0)){
        showToast("出発地・到着地・走行距離(km)を入力してから保存してください。");
        return;
      }
      var p = upsertCarPreset(origin, destination, km);
      populateCarPresetSelect();
      selectEl.value = p.id;
      showToast("区間を保存しました：" + origin + " → " + destination);
      var original = saveBtn.textContent;
      saveBtn.textContent = "保存しました ✓";
      setTimeout(function(){ saveBtn.textContent = original; }, 1500);
    });

    deleteBtn.addEventListener("click", function(){
      var id = selectEl.value;
      if(!id){ showToast("削除する区間をまず選択してください。"); return; }
      var p = carPresets.find(function(x){ return x.id === id; });
      if(!p) return;
      showConfirm('「' + p.origin + ' → ' + p.destination + '」をプリセットから削除しますか？', function(){
        carPresets = carPresets.filter(function(x){ return x.id !== id; });
        saveCarPresets();
        populateCarPresetSelect();
        recalcCarAmount();
        renderCarPresetList(); // 「⚙ 申請者・区間の管理」画面を開いていた場合のために一覧も更新
        showToast("「" + p.origin + " → " + p.destination + "」を削除しました。");
      }, { okLabel:"削除する", cancelLabel:"キャンセル", danger:true });
    });

    return {
      num: n,
      getOriginText: getOriginText,
      getDestination: function(){ return destinationInput.value.trim(); },
      getKm: function(){ return Number(distanceInput.value) || 0; },
      updateSummary: updateSummary,
      reset: function(){
        selectEl.value = "";
        originInput.value = "";
        destinationInput.value = "";
        distanceInput.value = "";
        updateSummary();
      }
    };
  }

  var carLegBlocks = {
    2: document.getElementById("carLegBlock2"),
    3: document.getElementById("carLegBlock3"),
    4: document.getElementById("carLegBlock4")
  };
  var carLegCtrls = {
    1: setupCarLeg(1),
    2: setupCarLeg(2),
    3: setupCarLeg(3),
    4: setupCarLeg(4)
  };

  function isCarLegActive(n){
    return n === 1 || (carLegBlocks[n] && !carLegBlocks[n].hidden);
  }

  function recalcCarAmount(){
    var total = 0;
    var notes = [];
    for(var n=1; n<=CAR_LEG_COUNT; n++){
      var ctrl = carLegCtrls[n];
      ctrl.updateSummary();
      if(!isCarLegActive(n)) continue;
      var o = ctrl.getOriginText();
      var d = ctrl.getDestination();
      var km = ctrl.getKm();
      if(o && d && km > 0){
        total += calcCarYen(km);
        notes.push(o + " → " + d + "（" + km + "km）");
      }
    }
    carComputedAmount.textContent = "合計：" + formatYen(total);
    if(selectedCategory === "自家用車"){ fAmount.value = total > 0 ? total : ""; }
    carRouteNoteCombined = notes.length ? notes.join("／") : null;
    updateFinalRouteSummary();
  }

  // 自家用車の record.destination には、有効な区間のうち一番大きい番号の到着地を使う
  function getFinalCarDestination(){
    for(var n=CAR_LEG_COUNT; n>=1; n--){
      if(isCarLegActive(n)){
        var d = carLegCtrls[n].getDestination();
        if(d) return d;
      }
    }
    return "";
  }

  [2,3,4].forEach(function(n){
    var addBtn = document.getElementById("addCarLegBtn" + n);
    var removeBtn = document.getElementById("removeCarLegBtn" + n);
    var block = carLegBlocks[n];
    addBtn.addEventListener("click", function(){
      block.hidden = false;
      addBtn.hidden = true;
      recalcCarAmount();
    });
    removeBtn.addEventListener("click", function(){
      carLegCtrls[n].reset();
      block.hidden = true;
      addBtn.hidden = false;
      recalcCarAmount();
    });
  });

  /* 画像をそのまま保存すると容量を圧迫するため、
     Canvas（画像を描き直せる仕組み）を使って
     「横幅1000px・画質70%」程度まで自動で軽くしてから保存します */
  function resizeImage(file, maxDim, quality){
    return new Promise(function(resolve, reject){
      var reader = new FileReader();
      reader.onload = function(e){
        var img = new Image();
        img.onload = function(){
          var w = img.width, h = img.height;
          if(w > h){ if(w > maxDim){ h = Math.round(h * maxDim / w); w = maxDim; } }
          else { if(h > maxDim){ w = Math.round(w * maxDim / h); h = maxDim; } }
          var canvas = document.createElement("canvas");
          canvas.width = w; canvas.height = h;
          canvas.getContext("2d").drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL("image/jpeg", quality));
        };
        img.onerror = reject;
        img.src = e.target.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  fReceipt.addEventListener("change", function(){
    var file = fReceipt.files && fReceipt.files[0];
    if(!file) return;
    resizeImage(file, 1000, 0.7).then(function(dataUrl){
      pendingReceiptDataUrl = dataUrl;
      receiptPreview.src = dataUrl;
      receiptPreview.hidden = false;
    }).catch(function(){
      showToast("画像の読み込みに失敗しました。もう一度お試しください。");
    });
  });

  claimForm.addEventListener("submit", function(ev){
    ev.preventDefault();
    var ok = true;
    document.querySelectorAll(".field-error").forEach(function(el){ el.classList.remove("show"); });

    if(!selectedApplicantName){ document.getElementById("errApplicant").classList.add("show"); ok = false; }
    if(!selectedCategory){ document.getElementById("errCategory").classList.add("show"); ok = false; }
    var amountVal = Number(fAmount.value);
    if(!fAmount.value || isNaN(amountVal) || amountVal <= 0){ document.getElementById("errAmount").classList.add("show"); ok = false; }
    if(selectedCategory === "自家用車"){
      if(!getFinalCarDestination()){ document.getElementById("errCarDestination1").classList.add("show"); ok = false; }
    }else{
      if(!fDestination.value.trim()){ document.getElementById("errDestination").classList.add("show"); ok = false; }
    }
    if(!selectedPurposeType){ document.getElementById("errPurposeType").classList.add("show"); ok = false; }
    if(!fDate.value) ok = false;
    if(!ok){
      // 赤字の入力エラーだけだと気づきにくいため、トーストで知らせ、
      // 先頭（申請者欄）まで自動でスクロールする
      showToast("入力に不足があります。赤字の項目をご確認ください。");
      window.scrollTo(0,0);
      return;
    }

    // 電車代・自家用車の場合は、選んだ区間の内訳を記録しておく（詳細画面で確認できるように）
    var routeNote = null;
    if(selectedCategory === "電車代"){
      routeNote = trainRouteNoteCombined;
    }else if(selectedCategory === "自家用車"){
      routeNote = carRouteNoteCombined;
    }

    var record = {
      id: uid(),
      applicantName: selectedApplicantName,
      date: fDate.value,
      category: selectedCategory,
      amount: amountVal,
      destination: (selectedCategory === "自家用車") ? getFinalCarDestination() : fDestination.value.trim(),
      purposeType: selectedPurposeType,
      memo: fMemo.value.trim(),
      routeNote: routeNote,
      receiptImage: pendingReceiptDataUrl,
      status: "申請中",
      createdAt: new Date().toISOString()
    };

    // Enterキーで意図せずすぐ登録されてしまわないよう、
    // 保存の直前に内容確認のダイアログを必ず挟む
    var summaryLines = [
      "申請者：" + record.applicantName,
      "利用日：" + formatDate(record.date),
      "経費種別：" + record.category,
      "訪問先：" + record.destination,
      "利用目的：" + record.purposeType,
      "金額：" + formatYen(record.amount)
    ];
    if(record.routeNote) summaryLines.push("区間：" + record.routeNote);
    if(record.memo) summaryLines.push("メモ：" + record.memo);
    if(record.receiptImage) summaryLines.push("レシート画像：添付あり");

    showConfirm(
      "以下の内容で登録します。よろしいですか？\n\n" + summaryLines.join("\n"),
      function(){
        claims.push(record);
        saveClaims();
        refreshHome();
        saveLastApplicantName(record.applicantName);
        showToast("申請を登録しました。");
        showView("home");
        sendAutoNotification(record, "new_claim"); // 支払い担当者への自動通知を試みる（失敗時はトーストのみ）
      },
      { okLabel:"はい・登録する", cancelLabel:"いいえ・修正する" }
    );
  });

  document.getElementById("newClaimBtn").addEventListener("click", function(){
    resetForm();
    showView("form");
  });
  document.getElementById("formBackBtn").addEventListener("click", function(){
    showView("home");
  });

  /* =========================================================
     申請詳細画面
     ========================================================= */
  var detailContent = document.getElementById("detailContent");
  var currentDetailId = null;

  function openDetail(id){
    currentDetailId = id;
    renderDetail();
    showView("detail");
  }

  function renderDetail(){
    var c = claims.find(function(x){ return x.id === currentDetailId; });
    if(!c){ showView("home"); return; }

    var html = '<div class="detail-block">';
    html += '<div class="detail-row"><span class="k">ステータス</span><span class="v"><span class="status-pill" data-status="'+c.status+'">'+c.status+'</span></span></div>';
    html += '<div class="detail-row"><span class="k">申請者</span><span class="v">'+escapeHtml(c.applicantName)+'</span></div>';
    html += '<div class="detail-row"><span class="k">利用日</span><span class="v">'+formatDate(c.date)+'</span></div>';
    html += '<div class="detail-row"><span class="k">経費種別</span><span class="v">'+c.category+'</span></div>';
    if(c.routeNote){
      html += '<div class="detail-row"><span class="k">区間</span><span class="v">'+escapeHtml(c.routeNote)+'</span></div>';
    }
    html += '<div class="detail-row"><span class="k">金額</span><span class="v">'+formatYen(c.amount)+'</span></div>';
    html += '<div class="detail-row"><span class="k">訪問先</span><span class="v">'+escapeHtml(c.destination)+'</span></div>';
    html += '<div class="detail-row"><span class="k">利用目的</span><span class="v">'+escapeHtml(c.purposeType)+'</span></div>';
    if(c.memo){
      html += '<div class="detail-row" style="flex-direction:column;align-items:flex-start;"><span class="k">メモ</span><div class="detail-memo">'+escapeHtml(c.memo)+'</div></div>';
    }
    html += '</div>';

    if(c.receiptImage){
      html += '<img class="detail-receipt" src="'+c.receiptImage+'" alt="レシート画像">';
    }

    html += '<div class="detail-block">';
    html += '<div class="section-title" style="margin-top:0;">ステータス変更（試作版のため手動切り替え・本来は承認者側の操作です）</div>';
    html += '<div class="status-switch" id="statusSwitch">';
    STATUS_LIST.forEach(function(st){
      html += '<button type="button" class="btn-secondary" data-status="'+st+'" aria-pressed="'+(c.status===st)+'">'+st+'</button>';
    });
    html += '</div></div>';

    html += '<button type="button" class="btn-danger-text" id="deleteClaimBtn">この申請を削除する</button>';

    detailContent.innerHTML = html;

    detailContent.querySelectorAll("#statusSwitch button").forEach(function(btn){
      btn.addEventListener("click", function(){
        var becameApproved = (btn.dataset.status === "承認済み" && c.status !== "承認済み");
        var becameReceived = (btn.dataset.status === "受領済み" && c.status !== "受領済み");
        c.status = btn.dataset.status;
        saveClaims();
        refreshHome();
        renderDetail();
        if(becameApproved){
          sendAutoNotification(c, "approved"); // 支払い担当者が承認したことを、申請者へ自動で通知する
        }
        if(becameReceived){
          sendAutoNotification(c, "received"); // 申請者が受領済みにしたことを、支払い担当者へ自動で通知する
        }
      });
    });
    document.getElementById("deleteClaimBtn").addEventListener("click", function(){
      showConfirm("この申請を削除します。よろしいですか？", function(){
        claims = claims.filter(function(x){ return x.id !== c.id; });
        saveClaims();
        refreshHome();
        showToast("削除しました。");
        showView("home");
      }, { okLabel:"削除する", cancelLabel:"キャンセル", danger:true });
    });
  }

  document.getElementById("detailBackBtn").addEventListener("click", function(){
    showView("home");
  });

  /* =========================================================
     区間・距離の管理画面
     ========================================================= */
  document.getElementById("openPresetsBtn").addEventListener("click", function(){
    renderApplicantPresetList();
    renderDestinationPresetList();
    renderTrainPresetList();
    renderCarPresetList();
    showView("presets");
  });
  document.getElementById("presetsBackBtn").addEventListener("click", function(){
    showView("home");
  });

  function escapeHtml(s){
    var div = document.createElement("div");
    div.textContent = s == null ? "" : s;
    return div.innerHTML;
  }

  /* =========================================================
     初期表示
     ========================================================= */
  populateTrainPresetSelect();
  populateCarPresetSelect();
  populateDestinationPresetSelect();
  resetForm();
  refreshHome();
  showView("home");

})();
</script>
