<script>
(function(){
  "use strict";

  /* =========================================================
     データの保存・読み込み（localStorage = ブラウザの中の保存領域）
     ========================================================= */
  var STORAGE_KEY = "expenseClaims_v1";

  function loadClaims(){
    try{
      var raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    }catch(e){
      // プライベートブラウズ中などlocalStorageが使えない場合はここに来ます
      console.warn("読み込みに失敗しました", e);
      return [];
    }
  }

  function saveClaims(){
    try{
      localStorage.setItem(STORAGE_KEY, JSON.stringify(claims));
    }catch(e){
      showToast("保存に失敗しました。レシート画像のサイズが大きすぎる可能性があります。");
    }
  }

  var claims = loadClaims(); // アプリ起動時に、保存済みの申請一覧を読み込む

  function uid(){
    if(window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return "id-" + Date.now() + "-" + Math.random().toString(16).slice(2);
  }

  // 前回入力した申請者名を覚えておき、次回の入力の手間を減らす
  var LAST_APPLICANT_KEY = "lastApplicantName_v1";
  function loadLastApplicantName(){
    try{ return localStorage.getItem(LAST_APPLICANT_KEY) || ""; }catch(e){ return ""; }
  }
  function saveLastApplicantName(name){
    try{ localStorage.setItem(LAST_APPLICANT_KEY, name); }catch(e){ /* 保存できなくても致命的ではないので無視 */ }
  }

  /* =========================================================
     申請者（よく使う名前）
     端末（スマートフォン）ごとにlocalStorageへ保存されるため、
     「この端末を使っている人」を自動的に選んだ状態にできます。
     ========================================================= */
  var APPLICANT_KEY = "applicantPresets_v1";
  function loadApplicantPresets(){
    try{ var r = localStorage.getItem(APPLICANT_KEY); return r ? JSON.parse(r) : []; }
    catch(e){ return []; }
  }
  function saveApplicantPresets(){
    try{ localStorage.setItem(APPLICANT_KEY, JSON.stringify(applicantPresets)); }
    catch(e){ showToast("申請者の保存に失敗しました。"); }
  }
  var applicantPresets = loadApplicantPresets();

  // 以前のバージョンで「前回入力した申請者名」だけが保存されているケース
  // （申請者一覧がまだ空）では、その名前を自動的に一覧へ追加しておく。
  // これをしないと、申請者を選ぶチップが1つも無い状態になってしまう。
  (function migrateLegacyApplicantName(){
    if(applicantPresets.length === 0){
      var legacyName = loadLastApplicantName();
      if(legacyName){
        applicantPresets.push({ id: uid(), name: legacyName });
        saveApplicantPresets();
      }
    }
  })();

  function addApplicantPreset(name){
    name = (name || "").trim();
    if(!name) return null;
    var existing = applicantPresets.find(function(p){ return p.name === name; });
    if(!existing){
      existing = { id: uid(), name: name };
      applicantPresets.push(existing);
      saveApplicantPresets();
    }
    return existing;
  }

  function renderApplicantPresetList(){
    var el = document.getElementById("applicantPresetList");
    if(!el) return;
    el.innerHTML = "";
    if(applicantPresets.length===0){
      var e = document.createElement("div");
      e.className = "empty-state";
      e.textContent = "まだ登録がありません。新規申請画面の「申請者」欄から名前を追加できます。";
      el.appendChild(e);
      return;
    }
    applicantPresets.slice().sort(function(a,b){ return a.name.localeCompare(b.name,"ja"); }).forEach(function(p){
      var row = document.createElement("div");
      row.className = "preset-row";
      row.innerHTML = '<div class="info"><b></b></div><button type="button" class="preset-del">削除</button>';
      row.querySelector("b").textContent = p.name;
      row.querySelector(".preset-del").addEventListener("click", function(){
        showConfirm('「' + p.name + '」を削除しますか？', function(){
          applicantPresets = applicantPresets.filter(function(x){ return x.id !== p.id; });
          saveApplicantPresets();
          if(loadLastApplicantName() === p.name) saveLastApplicantName("");
          renderApplicantPresetList();
          renderApplicantChips();
        }, { okLabel:"削除する", cancelLabel:"キャンセル", danger:true });
      });
      el.appendChild(row);
    });
  }

  /* =========================================================
     通知（トースト）・確認ダイアログ
     このページはArtifactのサンドボックス内で動くため、標準の
     alert()やconfirm()が表示されない環境があります。
     そのため、ページ内で完結する自前の通知・確認UIを使います。
     ========================================================= */
  var toastEl = document.getElementById("toast");
  var toastTimer = null;
  function showToast(message){
    toastEl.textContent = message;
    toastEl.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ toastEl.classList.remove("show"); }, 2800);
  }

  var confirmOverlay = document.getElementById("confirmOverlay");
  var confirmMessage = document.getElementById("confirmMessage");
  var confirmOkBtn = document.getElementById("confirmOkBtn");
  var confirmCancelBtn = document.getElementById("confirmCancelBtn");
  var confirmCallback = null;
  // options.okLabel / options.cancelLabel / options.danger（削除など危険な操作は赤いボタンにする）
  function showConfirm(message, onConfirm, options){
    options = options || {};
    confirmMessage.textContent = message;
    confirmCallback = onConfirm;
    confirmOkBtn.textContent = options.okLabel || "OK";
    confirmCancelBtn.textContent = options.cancelLabel || "キャンセル";
    confirmOkBtn.className = options.danger ? "btn-danger" : "btn-primary";
    confirmOverlay.hidden = false;
  }
  function hideConfirm(){
    confirmOverlay.hidden = true;
    confirmCallback = null;
  }
  confirmOkBtn.addEventListener("click", function(){
    var cb = confirmCallback;
    hideConfirm();
    if(cb) cb();
  });
  confirmCancelBtn.addEventListener("click", hideConfirm);
  confirmOverlay.addEventListener("click", function(ev){
    if(ev.target === confirmOverlay) hideConfirm();
  });

  /* ---- 自動通知（Google Apps Script経由でLINE WORKSに送信） ----
     NOTIFY_ENDPOINT_URL に、Google Apps Scriptを「ウェブアプリ」として
     デプロイしたときに発行されるURL（https://script.google.com/macros/s/.../exec）
     を貼り付けると、次の3つのタイミングで自動的に通知が送られます。
       1) 申請者が新しく登録したとき（type: "new_claim"）　→ 支払い担当者へ
       2) 支払い担当者が「承認済み」に変更したとき（type: "approved"）→ 申請者へ
       3) 申請者が「受領済み」に変更したとき（type: "received"）→ 支払い担当者へ
     誰が誰に届くかの振り分け（LINE WORKSのユーザー個別宛て）はGoogle Apps Script側の
     設定で行うため、このアプリ側では「何があったか」を知らせるだけです。
     未設定の場合は何もしません。失敗した場合もトーストで知らせるだけです。 */
  var NOTIFY_ENDPOINT_URL = "https://script.google.com/macros/s/AKfycbxU04AvlgbvYqzylb6__XoxTtr9oIUHeRPPXfxH4xPSmKmHgwxwPYqVj3dfwX8DXrOW/exec";

  function sendAutoNotification(record, eventType){
    if(!NOTIFY_ENDPOINT_URL) return;
    eventType = eventType || "new_claim";
    var payload = {
      type: eventType,
      applicantName: record.applicantName,
      date: record.date,
      category: record.category,
      destination: record.destination,
      purposeType: record.purposeType,
      amount: record.amount,
      routeNote: record.routeNote || ""
    };
    var toastOnSuccess = {
      new_claim: "支払い担当者に自動で通知しました。",
      approved: "承認されたことを申請者へ自動で通知しました。",
      received: "受領済みになったことを支払い担当者へ自動で通知しました。"
    }[eventType] || "自動で通知しました。";
    fetch(NOTIFY_ENDPOINT_URL, {
      method: "POST",
      // Content-Typeをtext/plainにすることで、Google Apps Script側のCORSプリフライトを回避しています
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: JSON.stringify(payload)
    }).then(function(){
      showToast(toastOnSuccess);
    }).catch(function(err){
      console.warn("自動通知に失敗しました", err);
      showToast("自動通知に失敗しました。関係者に直接ご連絡ください。");
    });
  }

  /* =========================================================
     区間プリセット（電車代の運賃・自家用車の距離）
     運賃や距離は会社ごと・店舗ごとに違うため、こちらでは
     金額を決め打ちせず「一度調べたら保存して使い回す」方式にしています
     ========================================================= */
  var TRAIN_KEY = "trainPresets_v1";
  var CAR_KEY = "carPresets_v1";
  var DESTINATION_KEY = "destinationPresets_v1";

  function loadTrainPresets(){
    try{ var r = localStorage.getItem(TRAIN_KEY); return r ? JSON.parse(r) : []; }
    catch(e){ return []; }
  }
  function saveTrainPresets(){
    try{ localStorage.setItem(TRAIN_KEY, JSON.stringify(trainPresets)); }
    catch(e){ showToast("区間の保存に失敗しました。"); }
  }
  function loadCarPresets(){
    try{ var r = localStorage.getItem(CAR_KEY); return r ? JSON.parse(r) : []; }
    catch(e){ return []; }
  }
  function saveCarPresets(){
    try{ localStorage.setItem(CAR_KEY, JSON.stringify(carPresets)); }
    catch(e){ showToast("区間の保存に失敗しました。"); }
  }
  function loadDestinationPresets(){
    try{ var r = localStorage.getItem(DESTINATION_KEY); return r ? JSON.parse(r) : []; }
    catch(e){ return []; }
  }
  function saveDestinationPresets(){
    try{ localStorage.setItem(DESTINATION_KEY, JSON.stringify(destinationPresets)); }
    catch(e){ showToast("訪問先の保存に失敗しました。"); }
  }
  // 自家用車の金額計算：距離(km)は小数点以下を切り上げてから 30円 を掛ける
  function calcCarYen(km){
    return Math.ceil(Number(km) || 0) * 30;
  }

  var trainPresets = loadTrainPresets();
  var carPresets = loadCarPresets();
  var destinationPresets = loadDestinationPresets();

  // 同じ区間（出発→到着）がすでにあれば金額だけ上書きし、無ければ新規追加する
  function upsertTrainPreset(from, to, fare){
    var existing = trainPresets.find(function(p){ return p.from===from && p.to===to; });
    if(existing){ existing.fare = fare; }
    else{ existing = { id: uid(), from: from, to: to, fare: fare }; trainPresets.push(existing); }
    saveTrainPresets();
    return existing;
  }
  function upsertCarPreset(origin, destination, distanceKm){
    var existing = carPresets.find(function(p){ return p.origin===origin && p.destination===destination; });
    if(existing){ existing.distanceKm = distanceKm; }
    else{ existing = { id: uid(), origin: origin, destination: destination, distanceKm: distanceKm }; carPresets.push(existing); }
    saveCarPresets();
    return existing;
  }
  function upsertDestinationPreset(name){
    name = (name || "").trim();
    if(!name) return null;
    var existing = destinationPresets.find(function(p){ return p.name === name; });
    if(!existing){
      existing = { id: uid(), name: name };
      destinationPresets.push(existing);
      saveDestinationPresets();
    }
    return existing;
  }

  function populateTrainPresetSelect(){
    ["trainPresetSelect","trainPresetSelect2"].forEach(function(selId){
      var sel = document.getElementById(selId);
      if(!sel) return;
      var current = sel.value;
      sel.innerHTML = selId === "trainPresetSelect2"
        ? '<option value="">－ 追加しない －</option>'
        : '<option value="">－ 区間を選択 －</option>';
      trainPresets.slice().sort(function(a,b){ return (a.from+a.to).localeCompare(b.from+b.to,"ja"); }).forEach(function(p){
        var opt = document.createElement("option");
        opt.value = p.id;
        opt.textContent = p.from + " → " + p.to + "（" + formatYen(p.fare) + "）";
        sel.appendChild(opt);
      });
